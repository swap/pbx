{
  "name": "@pbx/sdk-ts",
  "private": true,
  "version": "0.1.0",
  "description": "PBX SDK TypeScript source (builds into ../javascript)",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('../javascript/protocol',{recursive:true});fs.copyFileSync('src/protocol/pbx.proto','../javascript/protocol/pbx.proto')\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "express": "^4.21.2",
    "fastify": "^5.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "fastify": { "optional": true }
  }
}
